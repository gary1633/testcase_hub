# =====================================================================
# FinX TestCase Hub — Production Environment Template (for DevOps)
# Copy to docker/.env.prod (DO NOT commit real secrets to Git!)
# =====================================================================

# Web UI public port (Nginx)
WEB_PORT=8080

# CORS origin matching domain or IP where users access the Web UI
CORS_ORIGIN=http://localhost:8080

# PostgreSQL credentials (PostgreSQL 16 container)
POSTGRES_USER=tcms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
POSTGRES_DB=tcms_db

# JWT signing secret (recommend: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=7d

# Production Bootstrap Mode:
#   superadmin = ONLY creates 1 Super Admin account, ZERO demo projects/cases
#   none       = no automatic user creation
#   demo       = creates demo QA/PM accounts & sample projects (local/staging only)
SEED_MODE=superadmin

# Initial Super Admin account (used only when users table is empty)
SUPERADMIN_EMAIL=admin@finx.vn
SUPERADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASS
SUPERADMIN_NAME=FinX Super Admin
SUPERADMIN_MUST_CHANGE_PASSWORD=true

# Set true only if Swagger (/api/docs) should be exposed internally
ENABLE_SWAGGER=false

# =====================================================================
# OPTIONAL: Google Workspace SSO ("Sign in with Google")
# Disabled by default when GOOGLE_CLIENT_ID is empty/commented.
# Note: Google OAuth requires HTTPS domain (or http://localhost) in
# Authorized JavaScript origins — LAN IP (http://192.168.x.x) is not supported.
# =====================================================================
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_ALLOWED_DOMAINS=finx.vn
# GOOGLE_AUTO_PROVISION=false
# GOOGLE_DEFAULT_ROLE=QA

# =====================================================================
# OPTIONAL: Gmail / SMTP Automatic Email (welcome, forgot-password, temp password)
# Disabled by default when SMTP_HOST / SMTP_USER / SMTP_PASS are empty.
# Works even on local/LAN hosting (only needs outbound internet port 587/465).
# For Gmail / Google Workspace: turn on 2FA and create an App Password.
# =====================================================================
# APP_PUBLIC_URL=https://tcms.finx.vn
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=qa-bot@finx.vn
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx
# SMTP_FROM="FinX TestCase Hub <qa-bot@finx.vn>"
