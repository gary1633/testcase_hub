# Backend Server
PORT=3001
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database Connection:
# Option 1 (Production / Docker PostgreSQL):
# DATABASE_URL=postgresql://tcms:tcms_password@localhost:5432/tcms_db
# Option 2 (Zero-config Embedded PostgreSQL via PGlite for local Windows dev):
DATABASE_URL=pglite://./data/pgdata

# Attachments local upload directory
UPLOAD_DIR=./uploads

# Bootstrap Seeding Mode:
#   demo       = local dev demo users (admin/lead/qa/pm) + sample projects WEB & MOB
#   superadmin = production clean start: ONLY 1 Super Admin account, zero sample projects/data
#   none       = skip automatic user seeding
SEED_MODE=demo

# Used when SEED_MODE=superadmin (first boot only when users table is empty)
SUPERADMIN_EMAIL=admin@finx.vn
SUPERADMIN_PASSWORD=FinxAdmin@2026!
SUPERADMIN_NAME=FinX Super Admin
SUPERADMIN_MUST_CHANGE_PASSWORD=true

# Optional: Google Workspace SSO (leave commented to disable)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_ALLOWED_DOMAINS=finx.vn
# GOOGLE_AUTO_PROVISION=false
# GOOGLE_DEFAULT_ROLE=QA

# Optional: Gmail / SMTP Auto-Email (leave commented to disable)
# APP_PUBLIC_URL=http://localhost:5173
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=qa-bot@finx.vn
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx
# SMTP_FROM="FinX TestCase Hub <qa-bot@finx.vn>"
